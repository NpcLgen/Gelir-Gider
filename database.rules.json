          ".write": "auth != null && root.child('data/users/'+auth.uid).child('active').val() !== false && (root.child('data/users/'+auth.uid).child('isAdmin').val() === true || !data.exists())",
          ".validate": "newData.hasChildren(['at','username'])"
        }
