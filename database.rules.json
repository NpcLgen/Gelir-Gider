{
  "rules": {
    ".read": false,
    ".write": false,
    "data": {
      ".read": "auth != null && root.child('data/users/'+auth.uid).child('active').val() !== false",
      ".write": "auth != null && root.child('data/users/'+auth.uid).child('active').val() !== false && root.child('data/users/'+auth.uid).child('isAdmin').val() === true",
      "users": {
        "$uid": {
          ".write": "auth != null && (root.child('data/users/'+auth.uid).child('isAdmin').val() === true || (auth.uid === $uid && !root.child('data/users').exists() && newData.child('isAdmin').val() === true))",
          ".validate": "newData.hasChildren(['id','username'])",
          "id": {
            ".validate": "newData.val() === $uid"
          },
          "username": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "isAdmin": {
            ".validate": "newData.isBoolean()"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "lastLogin": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString()"
          },
          "mustChangePassword": {
            ".write": "auth != null && auth.uid === $uid && newData.val() === false",
            ".validate": "newData.isBoolean()"
          },
          "permissions": {
            "$module": {
              ".validate": "newData.isBoolean()"
            }
          }
        }
      },
      "settings": {
        ".write": "auth != null && root.child('data/users/'+auth.uid).child('active').val() !== false && (root.child('data/users/'+auth.uid).child('isAdmin').val() === true || root.child('data/users/'+auth.uid).child('permissions/ayarlar').val() === true)"
      },
      "prices": {
        ".write": "auth != null && root.child('data/users/'+auth.uid).child('active').val() !== false && (root.child('data/users/'+auth.uid).child('isAdmin').val() === true || root.child('data/users/'+auth.uid).child('permissions/fiyatGirisi').val() === true)",
        "$roomId": {
          "$date": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          }
        }
      },
      "rooms": {
        ".write": "auth != null && root.child('data/users/'+auth.uid).child('active').val() !== false && (root.child('data/users/'+auth.uid).child('isAdmin').val() === true || root.child('data/users/'+auth.uid).child('permissions/odalar').val() === true)",
        "$id": {
          ".validate": "newData.hasChildren(['id'])",
          "id": {
            ".validate": "newData.val() === $id"
          }
        }
      },
      "expenses": {
        ".write": "auth != null && root.child('data/users/'+auth.uid).child('active').val() !== false && (root.child('data/users/'+auth.uid).child('isAdmin').val() === true || root.child('data/users/'+auth.uid).child('permissions/genelHarcamalar').val() === true)",
